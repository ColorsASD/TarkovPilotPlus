# Local tools and temporary checks (including nested app/.local)
.local/

# Generated builds and downloaded OCR dependencies
/app/build/bin/
/app/plus/ocr/runtime/
/app/*-res.syso

# Wails regenerates these bindings; the frontend uses window.go directly
/app/frontend/wailsjs/

# Browser test output and temporary profiles
/output/
.playwright-cli/

# Local credentials, application state and logs
.env
.env.*
!.env.example
!.env.template
api-key.bin
item-settings.json
item-quality.json
item-cache/
settings.json
logs/
*.log

# Temporary build and test files
*.test
*.test.exe
*.partial
*.tmp
*.old
coverage.out

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local deployment output and scripts
/deploy/dist/
/deploy*.ps1
